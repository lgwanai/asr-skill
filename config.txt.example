# ═══════════════════════════════════════════════════════════════
# ASR Skill 配置文件 (Properties 格式)
# ═══════════════════════════════════════════════════════════════
# 使用说明:
#   1. 复制此文件为 config.txt 并修改配置
#   2. 以 # 开头的行为注释
#   3. 配置格式: key = value
#   4. API 相关配置使用点号嵌套: api.url, api.key 等
#   5. mode 只能选择 local 或 api 其中之一（互斥）
#   6. 也可以通过环境变量设置: MIMO_API_KEY, MIMO_API_URL, ASR_CONFIG_PATH
# ═══════════════════════════════════════════════════════════════

# ── 运行模式（必选，二选一）──────────────────────────────────
# local: 本地运行 ASR 模型（FunASR），离线处理，数据不出本机
# api:   调用小米 MiMo ASR 云端 API（mimo-v2.5-asr），无需本地 GPU/模型
# 注意: local 和 api 互斥，只能选择其中一个
mode = local

# ── 本地模式配置（仅 mode = local 时生效）────────────────────
# ASR 引擎选择
# auto:       根据硬件自动选择（GPU → paraformer, CPU → sensevoice）【推荐】
# paraformer: Paraformer-Large 高精度模型（需 GPU 加速，支持说话人分离）
# sensevoice: SenseVoiceSmall 轻量级模型（CPU 友好，不支持说话人分离）
asr_model = auto

# 自定义模型下载/缓存目录
# 留空则使用各平台默认目录:
#   macOS:   ~/Library/Application Support/asr-skill/models/
#   Windows: %APPDATA%/asr-skill/models/
#   Linux:   ~/.local/share/asr-skill/models/
model_dir =

# ── 输出配置 ──────────────────────────────────────────────────
# 默认输出格式
# 可选值: txt（纯文本带时间戳）, json（结构化JSON）, srt（字幕）,
#         ass（样式字幕带说话人配色）, md（Markdown文档）
output_format = txt

# 默认输出目录
# 留空则输出到输入文件相同目录
output_dir =

# ── API 模式配置（仅 mode = api 时生效，与本地模式互斥）─────
# 小米 MiMo ASR API (mimo-v2.5-asr)
# API 文档: https://platform.xiaomimimo.com/docs/zh-CN/usage-guide/Speech-Recognition
#
# 注意:
#   - 音频通过 chat completions 接口以 Base64 data URL 格式上传
#   - Base64 编码后最大 10 MB（原始文件建议不超过 7 MB）
#   - 支持 wav 和 mp3 格式
#   - 如需处理更长音频，请使用 local 模式

# MiMo API 服务基础 URL（通常无需修改）
# 默认: https://api.xiaomimimo.com/v1
# 也可通过环境变量 MIMO_API_URL 设置
api.url =

# MiMo API 密钥（必填）
# 获取方式: https://platform.xiaomimimo.com/profile
# 也可通过环境变量 MIMO_API_KEY 设置
api.key =

# ASR 模型名称（当前仅支持 mimo-v2.5-asr）
api.model = mimo-v2.5-asr

# 语言选项
# auto: 自动检测（默认）
# zh:   中文（含粤语、吴语、闽南语、四川话等方言）
# en:   英文
api.language = auto

# API 请求超时时间（单位: 秒）
# 默认 300 秒（5 分钟）
api.timeout = 300

# 最大音频文件大小（单位: MB，原始文件，Base64 编码前）
# MiMo API 限制 Base64 编码后 ≤ 10 MB，原始文件约 7.5 MB
# 超过此大小的文件请使用 local 模式
api.max_file_mb = 7

# 额外的 HTTP 请求头（JSON 格式键值对）
# 用于需要自定义 Header 的场景，例如:
# api.headers = {"X-Custom-Header": "value"}
# 留空表示不添加额外请求头
api.headers = {}
